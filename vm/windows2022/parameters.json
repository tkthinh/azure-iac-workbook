{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "southeastasia"
    },
    "vmName": {
      "value": "vm-windows-demo"
    },
    "vmSize": {
      "value": "Standard_B2s"
    },
    "subnetId": {
      "value": "/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.Network/virtualNetworks/<vnet-name>/subnets/<subnet-name>"
    },
    "adminUsername": {
      "value": "azureuser"
    },
    "adminPassword": {
      "value": "<supply-securely-at-deployment>"
    },
    "enablePublicIp": {
      "value": false
    },
    "osDiskSizeGB": {
      "value": 127
    },
    "tags": {
      "value": {
        "environment": "dev",
        "workload": "windows-vm"
      }
    }
  }
}
