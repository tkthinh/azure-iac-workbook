{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "15786797822748413204"
    }
  },
  "parameters": {
    "serverName": {
      "type": "string",
      "metadata": {
        "description": "Name of the MySQL Flexible Server."
      }
    },
    "administratorLogin": {
      "type": "string",
      "metadata": {
        "description": "Administrator login name. The password is supplied as a secure parameter."
      }
    },
    "administratorPassword": {
      "type": "securestring",
      "metadata": {
        "description": "Administrator password. Do not place a real value in parameters.json."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for the server. Defaults to the resource group location."
      }
    },
    "skuName": {
      "type": "string",
      "defaultValue": "Standard_D2ds_v4",
      "metadata": {
        "description": "Compute SKU name."
      }
    },
    "skuTier": {
      "type": "string",
      "defaultValue": "GeneralPurpose",
      "allowedValues": [
        "Burstable",
        "GeneralPurpose",
        "BusinessCritical"
      ],
      "metadata": {
        "description": "Compute tier."
      }
    },
    "storageSizeGb": {
      "type": "int",
      "defaultValue": 32,
      "minValue": 20,
      "metadata": {
        "description": "Allocated storage in GB."
      }
    },
    "version": {
      "type": "string",
      "defaultValue": "8.0.21",
      "allowedValues": [
        "8.0.21"
      ],
      "metadata": {
        "description": "MySQL major version."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Optional tags to apply to the server."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.DBforMySQL/flexibleServers",
      "apiVersion": "2023-12-30",
      "name": "[parameters('serverName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "sku": {
        "name": "[parameters('skuName')]",
        "tier": "[parameters('skuTier')]"
      },
      "properties": {
        "administratorLogin": "[parameters('administratorLogin')]",
        "administratorLoginPassword": "[parameters('administratorPassword')]",
        "version": "[parameters('version')]",
        "storage": {
          "storageSizeGB": "[parameters('storageSizeGb')]",
          "autoGrow": "Enabled",
          "iops": 360
        },
        "backup": {
          "backupRetentionDays": 7,
          "geoRedundantBackup": "Disabled"
        },
        "network": {
          "publicNetworkAccess": "Enabled"
        }
      }
    }
  ],
  "outputs": {
    "serverId": {
      "type": "string",
      "value": "[resourceId('Microsoft.DBforMySQL/flexibleServers', parameters('serverName'))]"
    },
    "serverName": {
      "type": "string",
      "value": "[parameters('serverName')]"
    },
    "fullyQualifiedDomainName": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.DBforMySQL/flexibleServers', parameters('serverName')), '2023-12-30').fullyQualifiedDomainName]"
    }
  }
}